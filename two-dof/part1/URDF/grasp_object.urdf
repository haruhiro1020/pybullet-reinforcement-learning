<?xml version="1.0"?>
<robot name="grasp_object">

    <!-- 把持対象物 (赤い球) -->
    <link name="base_link">

        <!-- 見た目 -->
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <!-- 干渉判定 -->
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
        </collision>

        <!-- 慣性 -->
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
        </inertial>

    </link>

</robot>
